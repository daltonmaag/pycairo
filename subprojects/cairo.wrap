[wrap-git]
url = https://gitlab.freedesktop.org/cairo/cairo.git
# The latest cairo release is out of date and will bomb compilation for weird
# reasons. People updated meson stuff in git main in the meantime. Next release
# after v1.18.4 hopefully we can use it again. Revision has to be a commit hash
revision = 4541e0cd3a751b85e52e2a83d02ac6145a5efa85
depth = 1

[provide]
dependency_names = cairo, cairo-gobject, cairo-script-interpreter
